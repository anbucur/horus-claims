<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Import Spring Boot defaults so base appenders are available in non-JSON profiles -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!--
      JSON console appender — active in all profiles.
      Fields emitted per line:
        @timestamp, level, logger_name, message, correlationId, claimId, traceId, spanId, thread_name, stack_trace
    -->
    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeContext>false</includeContext>
            <includeMdc>true</includeMdc>
            <customFields>{"service":"claims-api"}</customFields>
            <fieldNames>
                <timestamp>@timestamp</timestamp>
                <message>message</message>
                <logger>logger_name</logger>
                <thread>thread_name</thread>
                <levelValue>[ignore]</levelValue>
            </fieldNames>
        </encoder>
    </appender>

    <!-- Root logger -->
    <root level="INFO">
        <appender-ref ref="JSON_CONSOLE"/>
    </root>

    <!-- Package-level overrides -->
    <logger name="com.msig.claimsapi" level="DEBUG" additivity="false">
        <appender-ref ref="JSON_CONSOLE"/>
    </logger>
    <logger name="org.hibernate.SQL" level="WARN" additivity="false">
        <appender-ref ref="JSON_CONSOLE"/>
    </logger>
    <logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="WARN" additivity="false">
        <appender-ref ref="JSON_CONSOLE"/>
    </logger>
    <logger name="io.temporal" level="WARN" additivity="false">
        <appender-ref ref="JSON_CONSOLE"/>
    </logger>

</configuration>
