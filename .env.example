# DB_PASSWORD: PostgreSQL password for the claims database
DB_PASSWORD=claims_secure_pass

# VALKEY_PASSWORD: Redis/Valkey authentication password
VALKEY_PASSWORD=valkey_secure_pass

# SPRING_PROFILES: Spring profile (docker, dev, prod)
SPRING_PROFILES=docker

# KAFKA: Kafka connection string (used by all services)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# DATABASE_URL: Full PostgreSQL connection string
DATABASE_URL=postgresql://claims_user:claims_secure_pass@postgres:5432/claims

# AZURE_AI: Azure AI Foundry credentials (Phase 4)
# AZURE_AI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_AI_KEY=your-api-key

# GUIDEWIRE: Guidewire Cloud API credentials (Phase 5)
# GUIDEWIRE_BASE_URL=https://api.guidewire.com
# GUIDEWIRE_CLIENT_ID=your-client-id
# GUIDEWIRE_CLIENT_SECRET=your-client-secret
